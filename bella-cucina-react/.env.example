# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local development: mongodb://localhost:27017/bellacucina
# For MongoDB Atlas (production): mongodb+srv://username:password@cluster.mongodb.net/bellacucina?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/bellacucina

# Frontend URL (for CORS - not needed in production when serving from same origin)
FRONTEND_URL=http://localhost:5173
